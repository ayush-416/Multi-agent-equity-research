# Required
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model configuration
# Use gemini-2.5-flash for free tier (gemini-pro-latest requires paid billing)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Email alerts (for stock tracking feature)
RESEND_API_KEY=your_resend_api_key_here

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
CACHE_TTL_HOURS=6
LOG_LEVEL=INFO

# News analysis settings
NEWS_DAYS_BACK=7
NEWS_TRUSTED_ONLY=false
NEWS_DISABLE_DEDUP=false

# Verdict component weights (default: 1.0 each)
VERDICT_WEIGHT_NEWS=1.0
VERDICT_WEIGHT_FUNDAMENTALS=1.0
VERDICT_WEIGHT_TECHNICAL=1.0
VERDICT_WEIGHT_RISK=1.0
VERDICT_WEIGHT_FILINGS=1.0

# Verdict thresholds
VERDICT_THRESHOLD_INVEST=3.0
VERDICT_THRESHOLD_AVOID=-3.0

# Background jobs
ENABLE_WATCHLIST_SCHEDULER=false
