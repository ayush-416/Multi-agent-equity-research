# Required
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model configuration
# Use gemini-2.5-flash for free tier (gemini-pro-latest requires paid billing)
GEMINI_MODEL=gemini-2.5-flash

# Email alerts (for stock tracking feature)
RESEND_API_KEY=your_resend_api_key_here

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
CACHE_TTL_HOURS=6
LOG_LEVEL=INFO
